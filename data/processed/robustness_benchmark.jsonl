{"domain": "clinical", "id": "stress_clinical_0000", "private_spans": [{"identifier_type": "DIRECT", "replacement": "[PATIENT]", "text": "Lena Ortiz", "type": "PERSON"}, {"identifier_type": "DIRECT", "replacement": "[CLINIC]", "text": "Aurora Teen Clinic", "type": "ORG"}, {"identifier_type": "DIRECT", "replacement": "[DATE]", "text": "April 2, 2025", "type": "DATE"}, {"identifier_type": "DIRECT", "replacement": "[ID]", "text": "MRN-990100", "type": "ID"}, {"identifier_type": "DIRECT", "replacement": "[PHONE]", "text": "202-555-2100", "type": "PHONE"}, {"identifier_type": "DIRECT", "replacement": "[CLINICIAN]", "text": "Dr. Avery", "type": "PERSON"}, {"identifier_type": "QUASI", "replacement": "adolescent", "text": "17-year-old", "type": "AGE"}, {"identifier_type": "QUASI", "replacement": "[PREGNANCY_STATUS]", "text": "pregnant", "type": "SENSITIVE_ATTRIBUTE"}, {"identifier_type": "QUASI", "replacement": "performer", "text": "ballet dancer", "type": "OCCUPATION"}, {"identifier_type": "QUASI", "replacement": "[LOCATION]", "text": "Nome", "type": "LOCATION"}], "qa": [{"a": "eclampsia", "answer_aliases": ["eclampsia"], "q": "What diagnosis was made?"}, {"a": "magnesium sulfate 4 g IV loading dose followed by 1 g per hour", "answer_aliases": ["magnesium sulfate 4 g IV loading dose followed by 1 g per hour"], "q": "What treatment was started?"}], "source": "handwritten_stress", "stress_tags": ["exact_age", "pregnancy", "utility_critical_sensitive_attribute"], "task_critical_facts": [{"acceptable_generalizations": ["adolescent"], "fact": "17-year-old", "generalization_allowed": true, "type": "age"}, {"fact": "pregnant", "generalization_allowed": false, "type": "pregnancy"}, {"fact": "blood pressure 168/112 mmHg", "generalization_allowed": false, "type": "finding"}, {"fact": "3+ proteinuria", "generalization_allowed": false, "type": "finding"}, {"fact": "eclampsia", "generalization_allowed": false, "type": "diagnosis"}, {"fact": "magnesium sulfate 4 g IV loading dose followed by 1 g per hour", "generalization_allowed": false, "type": "treatment"}], "text": "Lena Ortiz, a 17-year-old pregnant ballet dancer from Nome, arrived at Aurora Teen Clinic on April 2, 2025 (record MRN-990100, phone 202-555-2100). She had a generalized seizure, blood pressure 168/112 mmHg, and 3+ proteinuria. Dr. Avery diagnosed eclampsia and started magnesium sulfate 4 g IV loading dose followed by 1 g per hour."}
{"domain": "clinical", "id": "stress_clinical_0001", "private_spans": [{"identifier_type": "DIRECT", "replacement": "[PATIENT]", "text": "Noah Kim", "type": "PERSON"}, {"identifier_type": "DIRECT", "replacement": "[CLINIC]", "text": "Cedar Valley Hospital", "type": "ORG"}, {"identifier_type": "DIRECT", "replacement": "[DATE]", "text": "May 9, 2025", "type": "DATE"}, {"identifier_type": "DIRECT", "replacement": "[ID]", "text": "MRN-990101", "type": "ID"}, {"identifier_type": "DIRECT", "replacement": "[EMAIL]", "text": "noah.kim@example.com", "type": "EMAIL"}, {"identifier_type": "DIRECT", "replacement": "[CLINICIAN]", "text": "Dr. Singh", "type": "PERSON"}, {"identifier_type": "QUASI", "replacement": "early 70s", "text": "72-year-old", "type": "AGE"}, {"identifier_type": "QUASI", "replacement": "retired professional", "text": "retired judge", "type": "OCCUPATION"}, {"identifier_type": "QUASI", "replacement": "[LOCATION]", "text": "Marfa", "type": "LOCATION"}], "qa": [{"a": "Lithium level was 1.8 mmol/L", "answer_aliases": ["Lithium level was 1.8 mmol/L"], "q": "Which level was abnormal?"}, {"a": "held lithium and started IV fluids", "answer_aliases": ["held lithium and started IV fluids", "held lithium", "IV fluids"], "q": "What treatment change was made?"}], "source": "handwritten_stress", "stress_tags": ["rare_occupation", "small_location", "numeric_lab"], "task_critical_facts": [{"fact": "tremor, ataxia, and confusion", "generalization_allowed": false, "type": "symptom"}, {"fact": "Lithium level was 1.8 mmol/L", "generalization_allowed": false, "type": "lab"}, {"fact": "lithium toxicity", "generalization_allowed": false, "type": "diagnosis"}, {"answer_aliases": ["held lithium", "IV fluids"], "fact": "held lithium and started IV fluids", "generalization_allowed": false, "type": "treatment"}, {"acceptable_generalizations": ["early 70s"], "fact": "72-year-old", "generalization_allowed": true, "type": "age"}], "text": "Noah Kim, a 72-year-old retired judge from Marfa, was seen at Cedar Valley Hospital on May 9, 2025 (record MRN-990101, email noah.kim@example.com). He had tremor, ataxia, and confusion after dehydration. Lithium level was 1.8 mmol/L. Dr. Singh diagnosed lithium toxicity, held lithium, and started IV fluids."}
